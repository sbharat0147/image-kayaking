# ══════════════════════════════════════════════════════════════════════════
#  LOCAL TEST ENVIRONMENT
#  Single VM — both DC1 and DC2 run on the same machine with offset ports.
#  Use with:
#    docker compose -p dc1 -f docker-compose.dc1.yml --env-file .env.local up -d
#    docker compose -p dc2 -f docker-compose.dc2-local.yml --env-file .env.local up -d
#
#  DO NOT use this file on production VMs.
# ══════════════════════════════════════════════════════════════════════════

# ── Network ────────────────────────────────────────────────────────────────
DC1_IP=127.0.0.1
DC2_IP=127.0.0.1
THIS_DC=dc1

# ── Port offsets (DC2 runs on +2 offset on the same host) ─────────────────
#   PostgreSQL  DC1=5432  DC2=5433
#   Patroni     DC1=8008  DC2=8009
#   MinIO S3    DC1=9000  DC2=9002
#   MinIO UI    DC1=9001  DC2=9003

# ── PostgreSQL / Patroni ───────────────────────────────────────────────────
POSTGRES_USER=appuser
POSTGRES_PASSWORD=localpass
POSTGRES_DB=appdb
PATRONI_SUPERUSER_PASSWORD=localpass_super
PATRONI_REPLICATION_PASSWORD=localpass_repl

# ── MinIO ──────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_DC1_URL=http://127.0.0.1:9000
MINIO_DC2_URL=http://127.0.0.1:9002
PGBACKREST_BUCKET=pgbackrest-local

# ── Monitoring ─────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=admin      # Grafana: admin / admin
PROMETHEUS_RETENTION=7d               # keep 7 days only — local disk is small

# ── MCP Server ─────────────────────────────────────────────────────────────
MCP_API_KEY=local-dev-key
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
VLLM_URL=http://localhost:8000
LLM_DEFAULT_BACKEND=ollama
DEBUG=true
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=*

# ── pgBackRest ─────────────────────────────────────────────────────────────
PGBACKREST_REPO_S3_KEY=minioadmin
PGBACKREST_REPO_S3_KEY_SECRET=minioadmin
