{
  "title": "Patroni HA — PostgreSQL DC/DR",
  "uid": "patroni-ha",
  "tags": ["patroni", "postgres", "ha", "dcdr"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Cluster Leader",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "patroni_master",
        "legendFormat": "{{dc}}"
      }],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "PRIMARY", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "REPLICA", "color": "blue" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }, { "color": "green", "value": 1 }]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Replication Lag (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 4, "y": 0, "w": 10, "h": 4 },
      "targets": [{
        "expr": "pg_replication_lag",
        "legendFormat": "{{dc}} lag"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 120 }
            ]
          },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 3,
      "title": "PostgreSQL Up",
      "type": "stat",
      "gridPos": { "x": 14, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "pg_up", "legendFormat": "{{dc}}" }],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } }
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Active Connections",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 9, "h": 6 },
      "targets": [{
        "expr": "pg_stat_activity_count",
        "legendFormat": "{{dc}} connections"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 5,
      "title": "Patroni Timeline",
      "type": "timeseries",
      "gridPos": { "x": 9, "y": 4, "w": 9, "h": 6 },
      "targets": [
        { "expr": "patroni_master", "legendFormat": "master {{dc}}" },
        { "expr": "patroni_replica", "legendFormat": "replica {{dc}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 6,
      "title": "Transactions Per Second",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 10, "w": 9, "h": 6 },
      "targets": [{
        "expr": "rate(pg_stat_database_xact_commit{datname!~\"template.*|postgres\"}[1m]) + rate(pg_stat_database_xact_rollback{datname!~\"template.*|postgres\"}[1m])",
        "legendFormat": "{{datname}} tps"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 7,
      "title": "Database Size",
      "type": "timeseries",
      "gridPos": { "x": 9, "y": 10, "w": 9, "h": 6 },
      "targets": [{
        "expr": "pg_database_size_bytes{datname!~\"template.*\"}",
        "legendFormat": "{{datname}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    }
  ]
}
