{
  "title": "Patroni HA — PostgreSQL DC/DR",
  "uid": "patroni-ha",
  "tags": ["patroni", "postgres", "ha", "dcdr"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 38,
  "panels": [

    { "id": 100, "type": "row", "title": "🟢 Cluster Overview", "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },

    {
      "id": 1, "title": "Cluster Leader", "type": "stat",
      "description": "Which node is currently the Patroni primary (master).",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "patroni_master", "legendFormat": "{{scope}}" }],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "PRIMARY ✓", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "REPLICA", "color": "blue" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },

    {
      "id": 2, "title": "PostgreSQL Status", "type": "stat",
      "description": "Whether the PostgreSQL process is reachable and accepting queries.",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "pg_up", "legendFormat": "postgres" }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP ✓", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "DOWN ✗", "color": "red" } } }
          ]
        }
      }
    },

    {
      "id": 3, "title": "WAL Timeline", "type": "stat",
      "description": "Current WAL timeline. Increments on every failover/promotion.",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "patroni_postgres_timeline", "legendFormat": "timeline" }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },

    {
      "id": 4, "title": "Replication Lag", "type": "stat",
      "description": "Current replication lag between primary and replica. Should be near 0.",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "pg_replication_lag", "legendFormat": "lag" }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 60 }
            ]
          }
        }
      }
    },

    {
      "id": 5, "title": "Active Connections", "type": "stat",
      "description": "Total active database connections right now.",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(pg_stat_activity_count{state=\"active\"})", "legendFormat": "connections" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      }
    },

    {
      "id": 6, "title": "Cluster Locked", "type": "stat",
      "description": "Whether the cluster has a leader (locked). Unlocked = no primary elected = danger.",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "patroni_cluster_unlocked", "legendFormat": "locked" }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "LOCKED ✓", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "NO LEADER ✗", "color": "red" } } }
          ]
        }
      }
    },

    { "id": 101, "type": "row", "title": "📡 Replication Health", "collapsed": false,
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 } },

    {
      "id": 10, "title": "Replication Lag Over Time", "type": "timeseries",
      "description": "How far behind the replica is from the primary WAL position. Spikes indicate replication delay.",
      "gridPos": { "x": 0, "y": 6, "w": 16, "h": 8 },
      "targets": [{ "expr": "pg_replication_lag", "legendFormat": "Replication Lag" }],
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 60 }
            ]
          },
          "custom": {
            "lineWidth": 2, "fillOpacity": 20,
            "thresholdsStyle": { "mode": "area" }
          }
        }
      }
    },

    {
      "id": 11, "title": "Patroni Node Roles", "type": "timeseries",
      "description": "1 = node is in that role. Watch for primary handover events.",
      "gridPos": { "x": 16, "y": 6, "w": 8, "h": 8 },
      "targets": [
        { "expr": "patroni_master", "legendFormat": "Master" },
        { "expr": "patroni_replica", "legendFormat": "Replica" },
        { "expr": "patroni_standby_leader", "legendFormat": "Standby Leader" }
      ],
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0, "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      }
    },

    { "id": 102, "type": "row", "title": "⚡ PostgreSQL Performance", "collapsed": false,
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 } },

    {
      "id": 20, "title": "Connections by State", "type": "timeseries",
      "description": "Active = running a query. Idle = connected but waiting. Idle in transaction = in a transaction but not querying (potential lock holder).",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "targets": [
        { "expr": "pg_stat_activity_count{state=\"active\"}", "legendFormat": "Active" },
        { "expr": "pg_stat_activity_count{state=\"idle\"}", "legendFormat": "Idle" },
        { "expr": "pg_stat_activity_count{state=\"idle in transaction\"}", "legendFormat": "Idle in Transaction ⚠" }
      ],
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Idle in Transaction ⚠" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      }
    },

    {
      "id": 21, "title": "Transactions Per Second", "type": "timeseries",
      "description": "Rate of committed and rolled-back transactions. Rollback spikes indicate errors.",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_xact_commit{datname!~\"template.*|postgres\"}[1m]))", "legendFormat": "Commits/s" },
        { "expr": "sum(rate(pg_stat_database_xact_rollback{datname!~\"template.*|postgres\"}[1m]))", "legendFormat": "Rollbacks/s ⚠" }
      ],
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Rollbacks/s ⚠" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      }
    },

    {
      "id": 22, "title": "Cache Hit Ratio", "type": "gauge",
      "description": "Percentage of queries served from memory vs disk. Below 95% indicates a need for more shared_buffers.",
      "gridPos": { "x": 0, "y": 23, "w": 6, "h": 7 },
      "targets": [{
        "expr": "100 * sum(pg_stat_database_blks_hit) / (sum(pg_stat_database_blks_hit) + sum(pg_stat_database_blks_read) + 1)",
        "legendFormat": "Cache Hit %"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      }
    },

    {
      "id": 23, "title": "Database Size", "type": "timeseries",
      "description": "Total size of each database on disk. Useful for capacity planning.",
      "gridPos": { "x": 6, "y": 23, "w": 10, "h": 7 },
      "targets": [{
        "expr": "pg_database_size_bytes{datname!~\"template.*\"}",
        "legendFormat": "{{datname}}"
      }],
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },

    {
      "id": 24, "title": "Dead Tuples (table bloat)", "type": "timeseries",
      "description": "Dead rows awaiting VACUUM. High counts indicate autovacuum is falling behind.",
      "gridPos": { "x": 16, "y": 23, "w": 8, "h": 7 },
      "targets": [{
        "expr": "sum by (relname) (pg_stat_user_tables_n_dead_tup)",
        "legendFormat": "{{relname}}"
      }],
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 10000 }
            ]
          },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },

    { "id": 103, "type": "row", "title": "📊 Query & Lock Stats", "collapsed": false,
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 } },

    {
      "id": 30, "title": "Rows Returned / Fetched / Inserted / Updated / Deleted", "type": "timeseries",
      "description": "Row-level throughput. Useful to understand read vs write workload mix.",
      "gridPos": { "x": 0, "y": 31, "w": 14, "h": 8 },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_tup_returned{datname!~\"template.*|postgres\"}[1m]))", "legendFormat": "Rows Returned/s" },
        { "expr": "sum(rate(pg_stat_database_tup_fetched{datname!~\"template.*|postgres\"}[1m]))", "legendFormat": "Rows Fetched/s" },
        { "expr": "sum(rate(pg_stat_database_tup_inserted{datname!~\"template.*|postgres\"}[1m]))", "legendFormat": "Rows Inserted/s" },
        { "expr": "sum(rate(pg_stat_database_tup_updated{datname!~\"template.*|postgres\"}[1m]))", "legendFormat": "Rows Updated/s" },
        { "expr": "sum(rate(pg_stat_database_tup_deleted{datname!~\"template.*|postgres\"}[1m]))", "legendFormat": "Rows Deleted/s" }
      ],
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "rps", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      }
    },

    {
      "id": 31, "title": "Temporary Files Created", "type": "timeseries",
      "description": "Temp files indicate queries that spill to disk (insufficient work_mem). Reduce these for better query performance.",
      "gridPos": { "x": 14, "y": 31, "w": 10, "h": 8 },
      "targets": [
        { "expr": "rate(pg_stat_database_temp_files{datname!~\"template.*\"}[5m])", "legendFormat": "{{datname}} temp files/s" },
        { "expr": "rate(pg_stat_database_temp_bytes{datname!~\"template.*\"}[5m])", "legendFormat": "{{datname}} temp bytes/s" }
      ],
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      }
    }

  ]
}
