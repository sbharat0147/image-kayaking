# Copy this file to .env on each VM and fill in actual values.
# .env is gitignored — never commit secrets.

# ── Network ────────────────────────────────────────────────────────────────
DC1_IP=192.168.1.10
DC2_IP=192.168.2.10
THIS_DC=dc1          # set to dc1 on DC1 VM, dc2 on DC2 VM

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=appdb
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=changeme_repl
PATRONI_SUPERUSER_PASSWORD=changeme_super
PATRONI_REPLICATION_PASSWORD=changeme_repl

# ── etcd ────────────────────────────────────────────────────────────────────
ETCD_INITIAL_CLUSTER=etcd-dc1=http://${DC1_IP}:2380,etcd-dc2=http://${DC2_IP}:2380

# ── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio
MINIO_DC1_URL=http://${DC1_IP}:9000
MINIO_DC2_URL=http://${DC2_IP}:9000
PGBACKREST_BUCKET=pgbackrest-archive

# ── pgBackRest ──────────────────────────────────────────────────────────────
PGBACKREST_REPO_S3_KEY=${MINIO_ROOT_USER}
PGBACKREST_REPO_S3_KEY_SECRET=${MINIO_ROOT_PASSWORD}
