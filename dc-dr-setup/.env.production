# ══════════════════════════════════════════════════════════════════════════
#  PRODUCTION ENVIRONMENT
#  Two separate VMs — DC1 VM and DC2 VM each run their own compose stack.
#  Use with:
#    [DC1 VM]  docker compose -p dc1 -f docker-compose.dc1.yml --env-file .env.production up -d
#    [DC2 VM]  docker compose -p dc2 -f docker-compose.dc2.yml  --env-file .env.production up -d
#
#  IMPORTANT:
#    - Fill in ALL values marked <CHANGE_ME> before deploying.
#    - Generate passwords with:  openssl rand -base64 32
#    - Copy this file to each VM separately. Never commit it to git.
#    - Restrict file permissions:  chmod 600 .env.production
# ══════════════════════════════════════════════════════════════════════════

# ── Network ────────────────────────────────────────────────────────────────
# Actual routable IPs of each VM on your production network.
DC1_IP=<CHANGE_ME>          # e.g. 10.10.1.11
DC2_IP=<CHANGE_ME>          # e.g. 10.10.2.11

# Set to "dc1" on the DC1 VM and "dc2" on the DC2 VM.
THIS_DC=<CHANGE_ME>

# ── PostgreSQL / Patroni ───────────────────────────────────────────────────
# Application database credentials
POSTGRES_USER=<CHANGE_ME>           # e.g. appuser
POSTGRES_PASSWORD=<CHANGE_ME>       # openssl rand -base64 32
POSTGRES_DB=<CHANGE_ME>             # e.g. myappdb

# Patroni internal accounts — never exposed to the application
PATRONI_SUPERUSER_PASSWORD=<CHANGE_ME>    # openssl rand -base64 32
PATRONI_REPLICATION_PASSWORD=<CHANGE_ME>  # openssl rand -base64 32

# ── MinIO ──────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=<CHANGE_ME>         # e.g. minio-admin (not "minioadmin")
MINIO_ROOT_PASSWORD=<CHANGE_ME>     # openssl rand -base64 32  (min 8 chars)
MINIO_DC1_URL=http://${DC1_IP}:9000
MINIO_DC2_URL=http://${DC2_IP}:9000
PGBACKREST_BUCKET=pgbackrest-archive

# ── Monitoring ─────────────────────────────────────────────────────────────
# Change immediately after first login to Grafana
GF_SECURITY_ADMIN_PASSWORD=<CHANGE_ME>    # openssl rand -base64 16
PROMETHEUS_RETENTION=30d                   # 30-day TSDB retention

# Alert routing — fill in at least one receiver in alertmanager.yml
# ALERTMANAGER_WEBHOOK_URL=https://your-internal-alerting-endpoint
# ALERTMANAGER_SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── MCP Server ─────────────────────────────────────────────────────────────
MCP_API_KEY=<CHANGE_ME>             # openssl rand -hex 32

# Ollama — point to the host running ollama serve
OLLAMA_URL=http://<CHANGE_ME>:11434  # e.g. http://10.10.1.50:11434
OLLAMA_MODEL=<CHANGE_ME>             # e.g. qwen2.5:7B-instruct-q4_k_m

# vLLM — leave blank if not using vLLM
VLLM_URL=http://<CHANGE_ME>:8000
VLLM_MODEL=<CHANGE_ME>

# Use ollama unless vLLM is deployed and reachable
LLM_DEFAULT_BACKEND=ollama

# Never enable debug in production
DEBUG=false

# Proxy — set to actual proxy if required; leave blank for direct access
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=${DC1_IP},${DC2_IP},localhost,127.0.0.1

# ── pgBackRest (S3 via MinIO) ───────────────────────────────────────────────
PGBACKREST_REPO_S3_KEY=${MINIO_ROOT_USER}
PGBACKREST_REPO_S3_KEY_SECRET=${MINIO_ROOT_PASSWORD}

# ── TLS (future) ───────────────────────────────────────────────────────────
# When TLS is enabled between Patroni nodes and MinIO, set paths here:
# TLS_CA_CERT=/etc/ssl/certs/internal-ca.crt
# TLS_CERT=/etc/ssl/certs/server.crt
# TLS_KEY=/etc/ssl/private/server.key
