[
  {
    "name": "web_search",
    "description": "Search the web or internal knowledge base for a given query.",
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {"type": "string", "description": "Search query string"},
        "limit": {"type": "integer", "description": "Max number of results (default 10)", "default": 10}
      },
      "required": ["query"]
    },
    "backend_type": "http",
    "endpoint": "http://search-service:8000/search",
    "method": "POST"
  },
  {
    "name": "semantic_search",
    "description": "Perform a semantic / vector similarity search over documents.",
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {"type": "string", "description": "Natural language search query"},
        "collection": {"type": "string", "description": "Document collection to search"},
        "top_k": {"type": "integer", "description": "Number of results to return", "default": 5}
      },
      "required": ["query"]
    },
    "backend_type": "http",
    "endpoint": "http://search-service:8000/semantic-search",
    "method": "POST"
  }
]
