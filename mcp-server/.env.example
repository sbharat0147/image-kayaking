# MCP Server environment configuration
# Copy to .env and fill in actual values

# ── Auth ────────────────────────────────────────────────────────────────────
API_KEY=changeme-mcp-api-key

# ── Upstream FastAPI services (comma-separated base URLs) ───────────────────
# MCP server will fetch /openapi.json from each and auto-register all endpoints as tools
UPSTREAM_SERVICES=http://notes-service:8000,http://search-service:8000

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120

# ── vLLM ────────────────────────────────────────────────────────────────────
VLLM_URL=http://vllm:8000
VLLM_MODEL=qwen
VLLM_TIMEOUT=120

# ── LLM routing ──────────────────────────────────────────────────────────────
LLM_DEFAULT_BACKEND=ollama   # ollama | vllm

# ── Debug ────────────────────────────────────────────────────────────────────
DEBUG=false
