# ══════════════════════════════════════════════════════════════════════════
#  MCP SERVER — LOCAL TEST ENVIRONMENT
#  Use with:
#    docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d
# ══════════════════════════════════════════════════════════════════════════

API_KEY=local-dev-key
UPSTREAM_SERVICES=http://localhost:8001,http://localhost:8002

# Ollama running on host machine
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LLM_DEFAULT_BACKEND=ollama

# vLLM — leave blank if not running locally
VLLM_URL=http://localhost:8000
VLLM_MODEL=

DEBUG=true

# Disable all proxy for local dev
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=*
no_proxy=*
