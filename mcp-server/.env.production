# ══════════════════════════════════════════════════════════════════════════
#  MCP SERVER — PRODUCTION ENVIRONMENT
#  Use with:
#    docker compose -f docker-compose.yml up -d
#
#  Fill in ALL <CHANGE_ME> values before deploying.
#  chmod 600 .env.production
# ══════════════════════════════════════════════════════════════════════════

# Authentication
API_KEY=<CHANGE_ME>            # openssl rand -hex 32

# Upstream FastAPI services — comma-separated base URLs
UPSTREAM_SERVICES=http://<service1-host>:<port>,http://<service2-host>:<port>

# Ollama inference server
OLLAMA_URL=http://<CHANGE_ME>:11434
OLLAMA_MODEL=<CHANGE_ME>       # e.g. qwen2.5:7B-instruct-q4_k_m

# vLLM inference server (optional — leave blank to use Ollama only)
VLLM_URL=http://<CHANGE_ME>:8000
VLLM_MODEL=<CHANGE_ME>

# Which backend to use when not explicitly specified
LLM_DEFAULT_BACKEND=ollama     # ollama | vllm

# Never enable debug in production
DEBUG=false

# Proxy — set if MCP server is behind a corporate proxy
# Leave blank for direct network access (typical in airgap env)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=<CHANGE_ME>           # comma-separated IPs/hostnames to bypass proxy
no_proxy=<CHANGE_ME>

# HF offline mode — always on in production (model is baked into image)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
